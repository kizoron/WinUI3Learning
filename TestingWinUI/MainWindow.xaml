<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TestingWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TestingWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TestingWinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" RowSpacing="16" Margin="0, 0, 0, 40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="360"/>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        
        <!-- stack panel -->
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="10" 
                Grid.Row="0">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <ListView
                    x:Name="ListDetailListView"
                    ItemsSource="{x:Bind Items}"
                    SelectedIndex="0"
                    SelectionMode="Single"
                    Grid.Row="0"
                    Width="200">
                       <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ListDetailItem" >
                                <StackPanel Padding="4" Spacing="2">
                                    <TextBlock Text="{x:Bind VideoName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Author}"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                       </ListView.ItemTemplate>
                </ListView>

                <StackPanel DataContext="{x:Bind ListDetailListView.SelectedItem, Mode=OneWay}" Grid.Column="1">
                    <TextBlock Text="{Binding VideoName}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Author}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />
                    <Image Width="320" Height="180" Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage UriSource="{Binding VideoImage}" />
                        </Image.Source>
                    </Image>
                    <TextBlock Text="{Binding Duration}" />
                    <TextBlock Text="{Binding Description}" />
                </StackPanel>
            </StackPanel>
        </Border>

        
        <!-- navigaation buttons -->
        <StackPanel Spacing="5" Orientation="Horizontal" Grid.Row="1">
        <Button Click="Button_Click" AutomationProperties.Name="Paste" Height="40px" Width="43px">
            <FontIcon Glyph="&#xE77F;" />
        </Button>

        <TextBox x:Name="InputBox" PlaceholderText="Insert your link" 
                 Width="500"
                 Height="40"
                 FontSize="16"
                 KeyDown="InputBox_KeyDown"/>

            <Button Click="Button_Input" KeyDown="InputBox_KeyDown" AutomationProperties.Name="Button_input" Height="40" Width="42" >
            <FontIcon Glyph="&#xE710;"/>
        </Button>
    </StackPanel>

        <Button Content="Play" Click="Button_Play" Height="40px" Width="595" Grid.Row="2"/>

    </Grid>
</Window>
    